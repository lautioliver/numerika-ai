# Servidor
PORT=3000

# Base de Datos (PostgreSQL — Supabase en prod)
# Local: DATABASE_URL=postgresql://...
# Vercel + Supabase integration: suele inyectar POSTGRES_URL (pooler) automáticamente
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=cambia_esto_por_un_secret_seguro_y_largo

# GEMINI AI (Google AI Studio — no OpenAI)
GEMINI_API_KEY=tu_clave_de_gemini_aqui
# Modelo opcional (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
# Local:
VITE_API_URL=http://localhost:3000
# Vercel (producción): dejar VITE_API_URL vacío o NO definirla → el SPA usa /api/* same-origin

# Motor Matemático (SymPy / FastAPI — SOLO local, NO definir en Vercel)
VITE_MATH_ENGINE_URL=http://localhost:8000

# ─── Vercel Dashboard (Environment Variables) ────────────────────────────────
# Obligatorias en producción:
#   JWT_SECRET, GEMINI_API_KEY, DATABASE_URL (PostgreSQL — Neon/Supabase/Railway)
# NO definir en Vercel:
#   VITE_MATH_ENGINE_URL  (el motor Python no corre en serverless)
# Opcional en Vercel:
#   VITE_API_URL          (vacío = same-origin; recomendado)
#   GEMINI_MODEL
